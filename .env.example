# Database demo mode needs no Supabase credentials. Mapbox maps need a public token.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Required for HQ account provisioning and private proof uploads; never use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe public Mapbox token (pk.); allow localhost and your deployed URL.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
